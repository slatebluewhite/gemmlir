+/* ---- gemmlir: memoize the tiling search -------------------------------- *
+ *
+ * `tiled_conv_stride_auto`, `tiled_conv_dw_auto` and `tiled_matmul_auto`
+ * search for a tiling on
+ * **every call**: one loop that shrinks a parameter until the shape fits the
+ * scratchpad, then two that grow parameters back while they still fit, each
+ * step costing two `tiled_conv_total_spad_rows`. PC sampling put that function
+ * alone at 3.8% of DenseNet, 2.3% of GoogLeNet and 2.0% of ShuffleNet, and the
+ * loops around it are counted inside their callers on top of that.
+ *
+ * The search is deterministic and depends only on integers a model's shapes
+ * fix, so the same key always has the same answer. Caching it is therefore not
+ * an approximation of the search -- it **is** the search, run once.
+ *
+ * Kept here rather than in the runtime so that nothing has to restate the
+ * search or the parameter marshalling around it. Single-threaded, like the
+ * rest of this header.
+ *
+ * | | ms | |
+ * |---|---|---|
+ * | `resnet50`           | 173.02 -> **130.23** | -24.7% |
+ * | `resnet18`           |  68.43 ->  **62.98** |  -8.0% |
+ * | `squeezenet1_1`      |  23.29 ->  **22.12** |  -5.0% |
+ * | `googlenet`          | 363.92 -> **347.79** |  -4.4% |
+ * | `mobilenet_v2`       |  93.77 ->  **90.01** |  -4.0% |
+ * | `densenet121`        | 743.81 -> **721.14** |  -3.0% |
+ * | the set              | 2628.96 -> **2534.04** | -3.6% |
+ *
+ * Every one of the thirteen models is byte for byte against both the CPU
+ * reference and the same object linked against the runtime as it was, which is
+ * the check that matters here: a different tiling would still be arithmetically
+ * correct, so only "the same answer as the search" proves the cache.
+ *
+ * `regnet_y_400mf` is the one model this costs: +1.1%, about 1.6 ms. Three
+ * ways of making the probe cheaper were built and measured against this, and
+ * **all three lost** on the set:
+ *
+ * | | the set |
+ * |---|---|
+ * | a hash per entry, plus move-to-front | +0.2% |
+ * | a hash per entry                     | +0.1% |
+ * | move-to-front alone                  | +0.1% |
+ *
+ * The reason is in the loop below: it breaks on the first key element that
+ * differs, so a miss is usually **one** integer compare, and RegNet has only 21
+ * distinct convolution shapes over its 584 calls -- the scan was never long.
+ * Hashing fifteen integers up front is pure work, and a move-to-front swaps a
+ * 22-integer entry on shapes that alternate. RegNet's +1.1% is not the scan;
+ * what it is has not been found, and it is 1.6 ms against the 94 ms this table
+ * saves.
+ *
+ * Also measured and reverted: the same cache on `tiled_matmul_auto`, +0.2% on
+ * the set. That search is a short growth loop with no shrink phase, so probing
+ * a cache costs more than running it -- `lstm` (65 matmuls) +2.9%, `vit_tiny`
+ * (74) +0.8%, `shufflenet_v2_x0_5` (21) +1.6%.
+ * ------------------------------------------------------------------------ */
+#define GEMMLIR_TILE_KEY 18
+#define GEMMLIR_TILE_SLOTS 512
+
+struct gemmlir_tile_entry {
+  int key[GEMMLIR_TILE_KEY];
+  int args[7];
+};
+
+static struct gemmlir_tile_entry gemmlir_tile_cache[3][GEMMLIR_TILE_SLOTS];
+static char gemmlir_tile_live[3][GEMMLIR_TILE_SLOTS];
+static int gemmlir_tile_used[3];
+
+/* Open addressing on the key, not a scan of it.
+ *
+ * A scan was measured first and was *right* at the time: with twenty-one
+ * distinct shapes it breaks on the first key element that differs, so a miss
+ * costs one compare, and hashing fifteen integers up front cost more than it
+ * saved (the set +0.1%). Then `--depthwise-as-block-diagonal` added a shape per
+ * depthwise layer and the models started making several hundred calls against
+ * a cache of fifty-odd entries: PC sampling put this function at **10.9% of
+ * MobileNetV2**. The scan was never wrong; the number of entries changed.
+ *
+ * | | ms | |
+ * |---|---|---|
+ * | `mobilenet_v2` | 65.98 -> **62.15** | -5.8% |
+ * | `mnasnet0_5` | 49.07 -> **46.29** | -5.7% |
+ * | `regnet_y_400mf` | 129.92 -> **123.52** | -4.9% |
+ * | `efficientnet_b0` | 328.77 -> **319.92** | -2.7% |
+ * | the set | 2322.44 -> **2294.63** | -1.2% |
+ *
+ * Byte for byte on all thirteen, as it must be: the table answers the same
+ * question. */
+/* Every check in the GEMMINI_ASSERTIONS blocks below -- the two scratchpad
+ * capacity totals, kernel_dim > padding, the dilation and transpose rules -- is
+ * a pure function of this key together with the tiling the table returns. So a
+ * hit is a proof that those checks already ran, on an earlier call, and passed.
+ * The key carries `padding`, `trans_output_1203` and `no_pool` for no other
+ * reason than to make that true: the tiling search itself never reads them.
+ *
+ * Measured on mobilenet_v2, whose 481 convolutions all hit: the two
+ * `tiled_conv_total_spad_rows` calls were 4.3% of the model, and they exist
+ * only to print and exit. */
+static int gemmlir_tile_validated = 0;
+
+static int gemmlir_tile_take_validated(void) {
+  int v = gemmlir_tile_validated;
+  gemmlir_tile_validated = 0;
+  return v;
+}
+
+/* One entry in front of the table. The hash is fifteen-odd multiplies and the
+ * probe another fifteen compares; a repeat of the immediately preceding key
+ * answers on the first element that differs, which for a repeat is none. */
+static int gemmlir_tile_last_key[3][GEMMLIR_TILE_KEY];
+static int gemmlir_tile_last_args[3][7];
+static char gemmlir_tile_last_live[3];
+
+static unsigned gemmlir_tile_hash(const int *key) {
+  unsigned h = 2166136261u;
+  for (int k = 0; k < GEMMLIR_TILE_KEY; k++)
+    h = (h ^ (unsigned)key[k]) * 16777619u;
+  return h;
+}
+
+static int gemmlir_tile_slot(int which, const int *key) {
+  unsigned mask = GEMMLIR_TILE_SLOTS - 1;
+  unsigned i = gemmlir_tile_hash(key) & mask;
+  while (gemmlir_tile_live[which][i]) {
+    const struct gemmlir_tile_entry *e = &gemmlir_tile_cache[which][i];
+    int same = 1;
+    for (int k = 0; k < GEMMLIR_TILE_KEY; k++)
+      if (e->key[k] != key[k]) { same = 0; break; }
+    if (same)
+      break;
+    i = (i + 1) & mask;
+  }
+  return (int)i;
+}
+
+static bool gemmlir_tile_same_as_last(int which, const int *key) {
+  if (!gemmlir_tile_last_live[which])
+    return false;
+  for (int k = 0; k < GEMMLIR_TILE_KEY; k++)
+    if (gemmlir_tile_last_key[which][k] != key[k])
+      return false;
+  return true;
+}
+
+static void gemmlir_tile_remember(int which, const int *key, const int *args) {
+  for (int k = 0; k < GEMMLIR_TILE_KEY; k++)
+    gemmlir_tile_last_key[which][k] = key[k];
+  for (int k = 0; k < 7; k++)
+    gemmlir_tile_last_args[which][k] = args[k];
+  gemmlir_tile_last_live[which] = 1;
+}
+
+static bool gemmlir_tile_get(int which, const int *key, int *args) {
+  if (gemmlir_tile_same_as_last(which, key)) {
+    for (int k = 0; k < 7; k++)
+      args[k] = gemmlir_tile_last_args[which][k];
+    return true;
+  }
+  int i = gemmlir_tile_slot(which, key);
+  if (!gemmlir_tile_live[which][i])
+    return false;
+  for (int k = 0; k < 7; k++)
+    args[k] = gemmlir_tile_cache[which][i].args[k];
+  gemmlir_tile_remember(which, key, args);
+  return true;
+}
+
+static void gemmlir_tile_put(int which, const int *key, const int *args) {
+  /* Past three quarters full the search simply runs, which is what it did
+     before this table existed. */
+  if (gemmlir_tile_used[which] * 4 >= GEMMLIR_TILE_SLOTS * 3)
+    return;
+  int i = gemmlir_tile_slot(which, key);
+  if (!gemmlir_tile_live[which][i]) {
+    gemmlir_tile_live[which][i] = 1;
+    gemmlir_tile_used[which]++;
+  }
+  struct gemmlir_tile_entry *e = &gemmlir_tile_cache[which][i];
+  for (int k = 0; k < GEMMLIR_TILE_KEY; k++)
+    e->key[k] = key[k];
+  for (int k = 0; k < 7; k++)
+    e->args[k] = args[k];
+  gemmlir_tile_remember(which, key, args);
+}
