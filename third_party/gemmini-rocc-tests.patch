+/* ---- gemmlir: choose the tiling by traffic, not by what fits first ------- *
+ *
+ * The search above shrinks the **largest** parameter until the shape fits the
+ * scratchpad, then grows parameters back. It has no notion of how much data the
+ * tiling then moves. The tile loop nest is
+ * `b -> porow -> pocol -> poch -> krow -> kcol -> kch`, so the **input is
+ * re-read once per output-channel tile** and the weights once per spatial tile
+ * -- and the largest parameter, the one the search gives up first, is usually
+ * the output channel count.
+ *
+ * GoogLeNet's `24x24x64 -> 64` 1x1 convolution is the shape of it: the search
+ * takes `out_channels` from 64 down to 16 to afford a 22x23 spatial tile, and
+ * then reads the whole input four times. `pochs=64, porows=24, pocols=5` moves
+ * a sixth of the data and fits the same scratchpad.
+ *
+ * Simulated over the 205 convolutions of `googlenet`, `efficientnet_b0` and
+ * `densenet121`, against the traffic-optimal tiling for each:
+ *
+ * | | the search | after this | optimal |
+ * |---|---|---|---|
+ * | googlenet | 5.5 MB (2.24x) | **2.8 MB (1.12x)** | 2.5 MB |
+ * | efficientnet_b0 | 4.6 (1.21x) | **3.7 (0.98x)** | 3.8 |
+ * | densenet121 | 9.5 (1.09x) | **9.1 (1.05x)** | 8.7 |
+ *
+ * Inverting the shrink order instead -- spatial first, channels last -- is
+ * *worse* than doing nothing (2.77x on googlenet): the grow-back phase is what
+ * makes the starting point good, and it needs a large parameter to grow from.
+ * So the search is left alone and its answer is the starting point for a hill
+ * climb on traffic, which costs at most about 170 evaluations and runs once per
+ * distinct shape, behind the memo.
+ *
+ * This changes only the order in which the accelerator is handed the same
+ * numbers. Integer accumulation is associative, so the result is unchanged.
+ */
+static int64_t gemmlir_conv_traffic(
+        int batch_size, int in_channels, int out_channels, int kernel_dim,
+        int pool_out_row_dim, int pool_out_col_dim,
+        int stride, int kernel_dilation, int pool_size, int pool_stride,
+        const int *a) {
+    const int batches = a[0], porows = a[1], pocols = a[2], pochs = a[3];
+    const int krows = a[4], kcols = a[5], kchs = a[6];
+    if (batches < 1 || porows < 1 || pocols < 1 || pochs < 1 ||
+        krows < 1 || kcols < 1 || kchs < 1)
+        return INT64_MAX;
+    const int orows = porows * pool_stride + pool_size - 1;
+    const int ocols = pocols * pool_stride + pool_size - 1;
+    const int krows_d = krows + (kernel_dilation - 1) * (krows - 1);
+    const int kcols_d = kcols + (kernel_dilation - 1) * (kcols - 1);
+    const int irows = orows * stride + krows_d - 1;
+    const int icols = ocols * stride + kcols_d - 1;
+
+    const int64_t nb = (batch_size + batches - 1) / batches;
+    const int64_t nr = (pool_out_row_dim + porows - 1) / porows;
+    const int64_t nc = (pool_out_col_dim + pocols - 1) / pocols;
+    const int64_t no = (out_channels + pochs - 1) / pochs;
+    const int64_t nkr = (kernel_dim + krows - 1) / krows;
+    const int64_t nkc = (kernel_dim + kcols - 1) / kcols;
+    const int64_t nkch = (in_channels + kchs - 1) / kchs;
+
+    const int64_t A = (int64_t)batches * irows * icols * kchs;
+    const int64_t B = (int64_t)krows * kcols * kchs * pochs;
+    const int64_t C = (int64_t)batches * porows * pocols * pochs;
+    const int64_t calls = nb * nr * nc * no * nkr * nkc * nkch;
+    return calls * (A + B) + nb * nr * nc * no * C;
+}
